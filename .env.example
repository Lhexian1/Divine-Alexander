# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / SITE_URL: Primary canonical URL for Alexanders Career Strategy
APP_URL="MY_APP_URL"
SITE_URL="https://www.alexanderscareerstrategy.com"

# SUPABASE CONFIGURATION (For Enquiry Metadata & Private CV Storage Bucket)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_CV_BUCKET="private-candidate-cvs"

# RESEND CONFIGURATION (For Transactional Email Notifications)
RESEND_API_KEY=""
EMAIL_FROM="notifications@alexanderscareerstrategy.com"
EMPLOYER_NOTIFICATION_EMAIL=""
CANDIDATE_NOTIFICATION_EMAIL=""

